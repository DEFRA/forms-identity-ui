# Server
NODE_ENV=development
PORT=3011
HOST=0.0.0.0

# Static assets
# How long browsers may keep images and fonts, whose filenames carry no
# content hash. One week in seconds; lower it to shorten how long a rebrand
# takes to reach returning visitors.
# STATIC_CACHE_MAX_AGE=604800

# Logging
LOG_ENABLED=true
LOG_LEVEL=debug
LOG_FORMAT=pino-pretty
# LOG_REDACT=req.headers.authorization,req.headers.cookie

# Tracing
TRACING_HEADER=x-cdp-request-id

# Session cache
# Engine is `memory` by default in development/test, `redis` in production
SESSION_CACHE_ENGINE=memory
SESSION_CACHE_NAME=session
# Four hours in milliseconds
SESSION_CACHE_TTL=14400000
SESSION_COOKIE_TTL=14400000
# Must be at least 32 characters (required in production, has a dev-only default otherwise)
SESSION_COOKIE_PASSWORD=
SESSION_COOKIE_SECURE=false

# Redis (used when SESSION_CACHE_ENGINE=redis, e.g. via `docker compose up redis`)
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_KEY_PREFIX=forms-identity-ui:
USE_SINGLE_INSTANCE_CACHE=true
REDIS_TLS=false

# Outbound proxy (optional)
# HTTP_PROXY=

# TLS trust store (CDP)
ENABLE_SECURE_CONTEXT=false

# OIDC provider (all required — the service refuses to start without them)
OIDC_ISSUER=http://localhost:3011
# Generate JWKS with: node scripts/generate-jwks.mjs
OIDC_JWKS=
# Generate two with: openssl rand -hex 32 (comma-separated)
OIDC_COOKIE_KEYS=
# The runner authenticates by signing an assertion (private_key_jwt), so this
# service holds only its public key — there is no shared secret.
# Generate the pair with: node scripts/generate-client-keypair.mjs
OIDC_RUNNER_JWKS=
OIDC_COOKIE_SECURE=false
# Local dev also wants the example RP callback (3901), which the e2e tests use too:
OIDC_RUNNER_REDIRECT_URIS=http://localhost:3009/callback,http://localhost:3000/callback,http://localhost:3901/callback
# The private half of the pair above, held by the client rather than the
# provider. Used by the example RP and the e2e suite, which stand in for
# forms-runner locally; in a real deployment only forms-runner holds it.
EXAMPLE_RP_PRIVATE_JWKS=

# OIDC artifact lifetimes in seconds (all required)
OIDC_TTL_AUTHORIZATION_CODE=60
OIDC_TTL_ID_TOKEN=300
OIDC_TTL_ACCESS_TOKEN=300
OIDC_TTL_INTERACTION=3600
OIDC_TTL_SESSION=86400
OIDC_TTL_GRANT=86400

# forms-identity-api (internal, required)
IDENTITY_API_URL=http://localhost:3010

# Service-to-service authentication
# Deployed environments on CDP automatically have these AWS_ endpints so they're only needed locally
# where we need touse an STS stub. They're read directly by the AWS API, not declared in our config.
AWS_ENDPOINT_URL_STS=http://localhost:4571
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=forms-identity-ui
AWS_SECRET_ACCESS_KEY=stub
SERVICE_AUTH_AUDIENCE=forms-identity-api
