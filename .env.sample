# Server
NODE_ENV=development
PORT=3011
HOST=0.0.0.0

# Logging
LOG_ENABLED=true
LOG_LEVEL=debug
LOG_FORMAT=pino-pretty
# LOG_REDACT=req.headers.authorization,req.headers.cookie

# Tracing
TRACING_HEADER=x-cdp-request-id

# Session cache
# Engine is `memory` by default in development/test, `redis` in production
SESSION_CACHE_ENGINE=memory
SESSION_CACHE_NAME=session
# Four hours in milliseconds
SESSION_CACHE_TTL=14400000
SESSION_COOKIE_TTL=14400000
# Must be at least 32 characters (required in production, has a dev-only default otherwise)
SESSION_COOKIE_PASSWORD=
SESSION_COOKIE_SECURE=false

# Redis (used when SESSION_CACHE_ENGINE=redis, e.g. via `docker compose up redis`)
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_KEY_PREFIX=forms-identity-ui:
USE_SINGLE_INSTANCE_CACHE=true
REDIS_TLS=false

# Outbound proxy (optional)
# HTTP_PROXY=

# TLS trust store (CDP)
ENABLE_SECURE_CONTEXT=false

# OIDC provider (all required — the service refuses to start without them)
OIDC_ISSUER=http://localhost:3011
# Generate JWKS with: node scripts/generate-jwks.mjs
OIDC_JWKS=
# Generate two with: openssl rand -hex 32 (comma-separated)
OIDC_COOKIE_KEYS=
# Generate with: openssl rand -hex 32 (forms-runner needs the same value)
OIDC_CLIENT_SECRET=
OIDC_COOKIE_SECURE=false
# Local dev also wants the example RP (3901) and e2e driver (3902) callbacks:
OIDC_RUNNER_REDIRECT_URIS=http://localhost:3009/callback,http://localhost:3000/callback,http://localhost:3901/callback,http://localhost:3902/callback

# OIDC artifact lifetimes in seconds (all required)
OIDC_TTL_AUTHORIZATION_CODE=60
OIDC_TTL_ID_TOKEN=300
OIDC_TTL_ACCESS_TOKEN=300
OIDC_TTL_INTERACTION=3600
OIDC_TTL_SESSION=86400
OIDC_TTL_GRANT=86400

# forms-identity-api (internal, required)
IDENTITY_API_URL=http://localhost:3010
