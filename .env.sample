# Server
NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# Logging
LOG_ENABLED=true
LOG_LEVEL=debug
LOG_FORMAT=pino-pretty
# LOG_REDACT=req.headers.authorization,req.headers.cookie

# Tracing
TRACING_HEADER=x-cdp-request-id

# Session cache
# Engine is `memory` by default in development/test, `redis` in production
SESSION_CACHE_ENGINE=memory
SESSION_CACHE_NAME=session
# Four hours in milliseconds
SESSION_CACHE_TTL=14400000
SESSION_COOKIE_TTL=14400000
# Must be at least 32 characters (required in production, has a dev-only default otherwise)
SESSION_COOKIE_PASSWORD=
SESSION_COOKIE_SECURE=false

# Redis (used when SESSION_CACHE_ENGINE=redis, e.g. via `docker compose up redis`)
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_KEY_PREFIX=forms-identity-ui:
USE_SINGLE_INSTANCE_CACHE=true
REDIS_TLS=false

# Identity API (private OIDC provider this façade fronts)
IDENTITY_API_URL=http://localhost:4001
IDENTITY_API_TIMEOUT_MS=10000

# OIDC issuer - this façade's own public URL (drives X-Forwarded-Proto/Host)
OIDC_ISSUER=http://localhost:3002

# Static assets
ASSET_PATH=/public
# One week in milliseconds
STATIC_CACHE_TIMEOUT=604800000

# Outbound proxy (optional)
# HTTP_PROXY=

# TLS trust store (CDP)
ENABLE_SECURE_CONTEXT=false
