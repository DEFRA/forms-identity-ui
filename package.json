{
  "name": "@defra/forms-identity-ui",
  "version": "0.0.0",
  "description": "Defra forms identity frontend",
  "type": "module",
  "main": ".server/index.js",
  "private": true,
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:client": "NODE_ENV=${NODE_ENV:-production} webpack",
    "build:server": "babel --delete-dir-on-start --extensions \".js\" --ignore \"**/*.test.js\" --copy-files --no-copy-ignored --source-maps --out-dir ./.server ./src",
    "dev": "concurrently \"npm run client:watch\" \"npm run server:watch:dev\" \"node example/rp/index.mjs\" --kill-others --names \"client,server,rp\" --prefix-colors \"red.dim,blue.dim,green.dim\"",
    "dev:debug": "concurrently \"npm run client:watch\" \"npm run server:watch:debug\" --kill-others --names \"client,server\" --prefix-colors \"red.dim,blue.dim\"",
    "format": "npm run format:check -- --write",
    "format:check": "prettier --cache --cache-location .cache/prettier --cache-strategy content --check \"**/*.{cjs,js,json,md,mjs,scss,ts}\"",
    "postinstall": "npm run setup:husky",
    "lint": "npm run lint:editorconfig && npm run lint:js && npm run lint:types",
    "lint:editorconfig": "editorconfig-checker",
    "lint:fix": "npm run lint:js -- --fix",
    "lint:js": "eslint --cache --cache-location .cache/eslint --cache-strategy content --color .",
    "lint:scss": "stylelint --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore --max-warnings 0 \"**/*.scss\"",
    "lint:types": "tsc --noEmit",
    "test": "jest --color --coverage --verbose",
    "test:watch": "jest --color --watch",
    "test:e2e": "playwright test",
    "client:watch": "NODE_ENV=development npm run build:client -- --watch",
    "server:watch": "NODE_ENV=development tsx watch --clear-screen=false --enable-source-maps --exclude \"**/*.test.*\"",
    "server:watch:dev": "npm run server:watch -- ./src/index.js",
    "server:watch:debug": "npm run server:watch -- --inspect-wait ./src/index.js",
    "prestart": "npm run build",
    "start": "NODE_ENV=${NODE_ENV:-production} node --enable-source-maps ./.server",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DEFRA/forms-identity-ui"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "engines": {
    "node": "^24.19.0",
    "npm": "^11.17.0 || >=12.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1112.0",
    "@defra/hapi-tracing": "^1.30.0",
    "@elastic/ecs-pino-format": "^1.5.0",
    "@hapi/boom": "^10.0.1",
    "@hapi/catbox-memory": "^6.0.2",
    "@hapi/catbox-redis": "^7.0.2",
    "@hapi/crumb": "^9.0.1",
    "@hapi/hapi": "^21.4.9",
    "@hapi/hoek": "^11.0.7",
    "@hapi/inert": "^7.1.2",
    "@hapi/scooter": "^8.0.0",
    "@hapi/vision": "^7.0.3",
    "@hapi/wreck": "^18.1.2",
    "@hapi/yar": "^11.0.3",
    "@smithy/node-http-handler": "^4.11.2",
    "blankie": "^5.0.0",
    "blipp": "^4.0.2",
    "convict": "^6.2.5",
    "dotenv": "^17.4.2",
    "google-libphonenumber": "^3.2.46",
    "govuk-frontend": "^5.13.0",
    "hapi-pino": "^13.0.0",
    "hapi-pulse": "^3.0.1",
    "http-status-codes": "^2.3.0",
    "i18next": "^26.3.6",
    "ioredis": "^5.11.1",
    "joi": "^17.13.3",
    "nunjucks": "^3.2.4",
    "oidc-provider": "^9.11.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "proxy-agent": "^8.0.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-import-attributes": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/convict": "^6.1.6",
    "@types/google-libphonenumber": "^7.4.31",
    "@types/govuk-frontend": "^5.11.0",
    "@types/hapi__crumb": "^7.3.7",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/nunjucks": "^3.2.6",
    "@types/oidc-provider": "^9.11.0",
    "autoprefixer": "^10.5.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-replace-import-extension": "^1.1.5",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^10.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "cssnano": "^8.0.2",
    "cssnano-preset-default": "^8.0.2",
    "editorconfig-checker": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "global-jsdom": "^26.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.3.0",
    "neostandard": "^0.13.0",
    "openid-client": "^6.8.4",
    "postcss": "^8.5.16",
    "postcss-load-config": "^6.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.4",
    "sass-embedded": "^1.100.0",
    "sass-loader": "^17.0.0",
    "source-map-loader": "^5.0.0",
    "stylelint": "^17.14.0",
    "stylelint-config-gds": "^3.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "webpack": "^5.108.4",
    "webpack-assets-manifest": "^6.5.2",
    "webpack-cli": "^7.2.1"
  },
  "allowScripts": {
    "@defra/hapi-tracing": true,
    "@parcel/watcher": true,
    "esbuild": true,
    "unrs-resolver": true,
    "fsevents": true
  }
}
